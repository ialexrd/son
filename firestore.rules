rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Дневник сна: один документ на ночь, id = дата YYYY-MM-DD
    match /nights/{date} {
      allow read: if true;
      allow delete: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date == date
        && request.resource.data.size() <= 12;
    }
  }
}
