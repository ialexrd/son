rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Дневник сна: один документ на ночь, id = дата YYYY-MM-DD
    match /nights/{date} {
      allow read: if true;
      allow delete: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow create, update: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date == date
        && request.resource.data.size() <= 12;
    }
    // Домашние работы, старый формат (только для переноса)
    match /homework/{id} {
      allow read, delete: if true;
    }
    // Домашние работы: постоянный список имён
    match /students/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.id == id
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.size() <= 4;
    }
    // Отметки «ДЗ задано»: id = <ученик>_<дата>
    match /hwmarks/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.id == id
        && id == request.resource.data.sid + '_' + request.resource.data.date
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.size() <= 4;
    }
  }
}
