rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Дневник сна: один документ на ночь, id = дата YYYY-MM-DD.
    // Доступ только после входа. Аккаунты создаются вручную в Firebase Console,
    // самостоятельная регистрация отключена (Authentication → Settings → User actions).
    match /nights/{date} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow create, update: if request.auth != null
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date == date
        && request.resource.data.size() <= 12;
    }
  }
}
